{
  "name": "open-software-factory",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3",
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "check": "bun run check:docs && bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run connector:check",
    "check:integration": "bun run check && bun run test:postgres && bun run test:forgejo && bun run runtime:conformance",
    "check:docs": "bun scripts/check-docs.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -b --pretty false",
    "runtime:conformance": "bun scripts/runtime/conformance.ts",
    "connector:check": "cd services/runtime-connector && go test -race ./... && go vet ./...",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "factory:dev": "vite --config apps/factory/vite.config.ts",
    "factory:build": "vite build --config apps/factory/vite.config.ts",
    "factory:serve": "bun apps/factory/src/server.ts",
    "factory:serve:detached": "nohup bun apps/factory/src/server.ts </dev/null >/tmp/open-factory-server.log 2>&1 &!",
    "factory:up": "bun scripts/factory/index.ts up",
    "factory:restart": "bun scripts/factory/index.ts restart",
    "factory:status": "bun scripts/factory/index.ts status",
    "factory:reset": "bun scripts/factory/index.ts reset --data",
    "test:browser": "playwright test",
    "test:recovery": "playwright test test/browser/runtime-recovery.spec.ts",
    "test:unit": "bun test apps/factory/src packages services scripts/factory --path-ignore-patterns 'services/runtime-connector/**'",
    "test:postgres": "bun scripts/integration/postgres.ts",
    "test:forgejo": "bun scripts/integration/forgejo.ts",
    "runtime:smoke:down": "kubectl --context orbstack delete namespace open-factory-envbox-smoke --ignore-not-found --wait=true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/deepseek": "3.0.63",
    "@ai-sdk/openai": "4.0.91",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/scim": "1.7.7",
    "@better-auth/sso": "1.7.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/sansita": "5.3.0",
    "@mastra/core": "1.76.0",
    "@opencode/ai": "2.0.27",
    "@opencode/client": "2.0.27",
    "@rocicorp/zero": "1.10.0",
    "@solidjs/router": "2.0.0-next.38",
    "@solidjs/web": "2.0.0-rc.14",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.7",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.1",
    "hast-util-to-html": "9.0.5",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "lowlight": "3.3.0",
    "marked": "18.1.1",
    "postgres": "3.4.9",
    "solid-js": "2.0.0-rc.14",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@solidjs/compiler": "2.0.0-rc.14",
    "@solidjs/signals": "2.0.0-rc.14",
    "@solidjs/vite-plugin": "3.0.0-next.49",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.14",
    "@solidjs/compiler": "2.0.0-rc.14",
    "@solidjs/signals": "2.0.0-rc.14",
    "solid-js": "2.0.0-rc.14",
    "@solidjs/web": "2.0.0-rc.14",
    "tinypool": "2.1.2"
  }
}
