{
  "name": "open-software-factory",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5",
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "check": "bun run check:docs && bun run db:check && bun run zero:check && bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run connector:check && bun run substrate:check",
    "check:integration": "bun run check && bun run test:controllers",
    "beta:gate": "bun scripts/release/beta-gate.ts",
    "release:clean-room": "bun scripts/release/clean-room.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "bun scripts/testing/typecheck.ts",
    "runtime:conformance": "bun run test:native substrate-adapter.native substrate-workspaces.native",
    "connector:check": "bun run connector:check:host && bun run connector:check:linux",
    "connector:check:host": "cd services/runtime-connector && mise exec -- go test -p 2 -race ./... && mise exec -- go vet -p 2 ./...",
    "connector:check:linux": "bun scripts/testing/connector-linux.ts",
    "substrate:check": "cd services/substrate-control && mise exec -- go test -p 2 -race ./... && mise exec -- go vet -p 2 ./...",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "db:generate": "bun packages/db/src/generate.ts",
    "db:check": "bun packages/db/src/generate.ts --check",
    "zero:generate": "bun packages/zero-schema/src/generate.ts",
    "zero:check": "bun packages/zero-schema/src/generate.ts --check",
    "factory:dev": "vite --config apps/factory/vite.config.ts",
    "factory:build": "vite build --config apps/factory/vite.config.ts && bun scripts/factory/compress-assets.ts",
    "factory:image": "bun scripts/factory/image.ts",
    "factory:connect": "bun scripts/kubernetes/connect.ts",
    "factory:up": "bun scripts/factory/index.ts up",
    "factory:restart": "bun scripts/factory/index.ts restart",
    "factory:status": "bun scripts/factory/index.ts status",
    "factory:reset": "bun scripts/factory/index.ts reset --data",
    "test:browser": "mise exec -- bun --no-env-file scripts/testing/browser.ts",
    "test:browser:native": "FACTORY_BROWSER_LANE=native bun run test:browser",
    "test:browser:paid": "FACTORY_BROWSER_LANE=paid bun run test:browser",
    "test:unit": "bun scripts/testing/lanes.ts unit",
    "test:controllers": "bun scripts/testing/lanes.ts controllers",
    "test:native": "bun scripts/testing/lanes.ts native",
    "test:live": "bun scripts/testing/lanes.ts live",
    "test:postgres": "bun scripts/integration/postgres.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/deepseek": "3.0.88",
    "@ai-sdk/openai": "4.0.121",
    "@better-auth/oauth-provider": "1.7.27",
    "@better-auth/scim": "1.7.27",
    "@better-auth/sso": "1.7.27",
    "@mastra/core": "1.85.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/canvas": "1.1.1",
    "@opencode/ai": "2.3.2",
    "@opencode/client": "2.3.2",
    "@plantuml/mcp-js": "0.2.4",
    "@rocicorp/zero": "1.12.0",
    "@solidjs/web": "2.0.3",
    "@tanstack/solid-router": "2.0.0-rc.11",
    "@tanstack/solid-start": "2.0.0-rc.11",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-code-block-lowlight": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-task-item": "3.35.0",
    "@tiptap/extension-task-list": "3.35.0",
    "@tiptap/markdown": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@viz-js/viz": "3.31.0",
    "better-auth": "1.7.27",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hast-util-to-html": "9.0.7",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "lowlight": "3.3.0",
    "mammoth": "1.13.0",
    "marked": "18.2.1",
    "modern-screenshot": "4.7.0",
    "pdfjs-dist": "6.5.438",
    "postgres": "4.1.1",
    "solid-js": "2.0.3",
    "stream-json": "3.9.0",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "yaml": "2.9.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/sansita": "5.3.0",
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/bun": "1.4.5",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "drizzle-zero": "0.21.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "patchedDependencies": {
    "@tanstack/start-server-core@1.169.45": "patches/tanstack-start-server-core-exports.patch"
  },
  "overrides": {
    "@solidjs/compiler": "2.0.2",
    "@solidjs/signals": "2.0.3",
    "solid-js": "2.0.3",
    "@solidjs/web": "2.0.3",
    "@tanstack/solid-start": "2.0.0-rc.11",
    "marked": "18.2.1",
    "highlight.js": "11.12.0"
  }
}
