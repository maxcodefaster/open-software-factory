[Unit]
Description=Factory local Kubernetes
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/factory-k3s server --data-dir /var/lib/factory-k3s --write-kubeconfig /etc/rancher/factory-k3s.yaml --write-kubeconfig-mode 600 --disable traefik --disable servicelb --disable metrics-server
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
