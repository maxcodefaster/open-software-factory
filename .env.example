# Local model relay. Keep real credentials in the gitignored .env file.
# Local bootstrap overrides. Set the password before creating an installation reachable by others.
# These do not reset an existing account. Later starts use its current credentials for Forge setup.
# FACTORY_ADMIN_EMAIL=admin@factory.local
# FACTORY_ADMIN_PASSWORD=replace-with-a-private-password
# OrbStack runtimes need host access; a loopback-only listener may prevent their callbacks.
# FACTORY_HOST=0.0.0.0
# Keep the existing local installation but run only its server in a built Linux image.
# The runtime callback must use the Linux node's actual reachable address, not the Mac alias.
# FACTORY_SERVER_IMAGE=open-software-factory:local
# FACTORY_RUNTIME_HOST=192.168.139.2
# Compose application deployment uses a separate state directory and project name.
# See deploy/local/README.md. Source development does not need these overrides.
# FACTORY_IMAGE=ghcr.io/maxcodefaster/open-software-factory/factory:<published-version>
# FACTORY_STATE_DIRECTORY=/absolute/path/to/private/factory-state
# FACTORY_KUBECONFIG=/absolute/path/to/self-contained-kubeconfig
# FACTORY_KUBERNETES_CONTEXT=orbstack
# Use a host address reachable from Pods and Docker containers on Linux.
# FACTORY_RUNTIME_HOST=host.orb.internal
# FACTORY_LOCAL_PORT=3100
# FACTORY_LOCAL_POSTGRES_PORT=58432
# FACTORY_LOCAL_FORGEJO_PORT=34030
# FACTORY_LOCAL_ZERO_PORT=5048
# Vite's local backend, only when using a different owned installation.
# FACTORY_DEV_BACKEND_URL=http://127.0.0.1:3000
FACTORY_MODEL_BASE_URL=https://provider.example/v1
FACTORY_MODEL_API_KEY=replace-me
FACTORY_AGENT_MODEL_ID=model-id
FACTORY_PROJECT_AGENT_MODEL=model-id
# Optional separate server-only connection for planning. Build retains FACTORY_MODEL_*.
FACTORY_PLANNING_MODEL_BASE_URL=https://provider.example/v1
FACTORY_PLANNING_MODEL_API_KEY=replace-me
FACTORY_KNOWLEDGE_MODEL=model-id
# The Helm chart provisions private storage for attachments and QA media automatically.
# These server-only settings are for source development against an owned Garage service.
# Never point a disposable proof at a retained installation's bucket.
# FACTORY_OBJECT_S3_ENDPOINT=http://127.0.0.1:3900
# FACTORY_OBJECT_S3_BUCKET=factory
# FACTORY_OBJECT_S3_REGION=garage
# FACTORY_OBJECT_S3_ACCESS_KEY_ID=replace-me
# FACTORY_OBJECT_S3_SECRET_ACCESS_KEY=replace-me
# FACTORY_ATTACHMENT_FILE_BYTES=10485760
# FACTORY_ATTACHMENT_MESSAGE_BYTES=20971520
# Server-only signing key and the Factory URL reachable from Forgejo. Local startup provides both.
# FACTORY_WIKI_WEBHOOK_URL=https://factory.example
# FACTORY_WIKI_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Optional comma-separated approved choices shown in Settings > Models.
FACTORY_MODEL_IDS=model-id,another-model-id
# Optional HTTPS origins for enterprise provider endpoints entered in Factory Settings.
# Native OpenAI, Anthropic and DeepSeek origins are already permitted.
# FACTORY_MODEL_ALLOWED_ORIGINS=https://models.example
# Published by factory:up. Override only with the exact approved browser image digest.
# FACTORY_BROWSER_TOOLS_IMAGE=registry.example/factory/browser-tools@sha256:<exact-digest>
# Source access stays available independently of execution. Published by factory:up.
# FACTORY_WORKSPACE_FILES_IMAGE=registry.example/factory/workspace-files@sha256:<exact-digest>
# FACTORY_DEVELOPER_IDE_IMAGE=registry.example/factory/developer-ide@sha256:<exact-digest>
# Required admitted Factorybox profile. The private worker image must be reachable by the node.
# Use the executable SHA-256 and exact node/kernel from the same verified native profile.
# FACTORY_FACTORYBOX_WORKER_IMAGE=registry.example/factorybox@sha256:<exact-digest>
# FACTORY_FACTORYBOX_EXECUTABLE_SHA256=<exact-executable-sha256>
# FACTORY_FACTORYBOX_ARCHITECTURE=<arm64-or-amd64>
# FACTORY_FACTORYBOX_NODE=<admitted-node-name>
# FACTORY_FACTORYBOX_KERNEL=<admitted-kernel-release>
# One common runtime host serves all execution roles and is published by factory:up.
# Clean reserve for fresh Staging and Verification, not retained Development Workspaces.
# One shared Project-bound pool: 2 unused paused Forks by default, 0 disables, 8 maximum.
# This is not a two-running-Sandbox limit. One concurrent preparation.
# Ready/in-flight/retiring reserve plus admitted runtimes share this hard capacity limit.
# FACTORY_EXECUTION_RESERVE_TARGET=2
# FACTORY_EXECUTION_MAX_SLOTS=16
# Development compute pauses after this inactive period. PTYs and admitted work prevent Pause.
# 0 disables automatic idle Pause; source editing is independent. Maximum 1440 minutes.
# FACTORY_EXECUTION_IDLE_MINUTES=5
# Project environment values use OpenBao KV v2, never this file or planning projections.
# HTTPS is mandatory. The token file must be private (mode 0600), scoped to Factory KV paths.
# FACTORY_OPENBAO_URL=https://openbao.example
# FACTORY_OPENBAO_TOKEN_FILE=/run/secrets/factory-openbao-token
# FACTORY_OPENBAO_MOUNT=factory
# FACTORY_OPENBAO_CA_FILE=/run/secrets/openbao-ca.pem
# HTTPS forge origins from which System Managers may import Git once.
# Forgejo's migration network policy must allow the same hosts and reject private networks.
FACTORY_GIT_IMPORT_ORIGINS=https://github.com,https://gitlab.com,https://codeberg.org
# factory:up derives Forgejo's exact host allowlist from these origins too.
