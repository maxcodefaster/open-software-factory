{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": [
      "bun",
      "vite/client",
      "@solidjs/vite-plugin/boundary-modules",
      "@solidjs/vite-plugin/virtual-solid-manifest"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
